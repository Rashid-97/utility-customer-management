# Native local setup: synchronous SQLAlchemy URL used by persistence and Alembic.
DATABASE_URL=postgresql+psycopg://customer_management:customer_management@localhost:5432/customer_management

# Docker Compose development settings.
POSTGRES_DB=customer_management
POSTGRES_USER=customer_management
POSTGRES_PASSWORD=customer_management
POSTGRES_PORT=5432
API_PORT=8000

